(* =====================================================================
   ProVerif — Merged design (Scenario 2), updated for the PID0-from-Vi fix
   aG/bG serve as the session nonces; authentication and key exchange
   are combined. Verifies secrecy + injective mutual authentication.

   M1: PID, T1, aG, A1   where A1 = hash(a1label, PID, T1, aG, Vi)
   M2: bG, MAC2          where MAC2 = hash(Kauth, aG, bG, m2label)
   M3: MAC3              where MAC3 = hash(Kauth, bG, aG, m3label)
   PID0 = hash(PIDINIT, Vi)   -- fixed, derived from Vi, NOT the
                                 rotating wire identifier PID used
                                 in M1/A1 above
   Kauth = kdf_auth(K0, Vi, aG, bG)
   K0    = kdf_k0(Vi, PID0)
   ===================================================================== *)

free c : channel.

type key.
type G.
type exponent.

fun hash(bitstring) : bitstring.
const VERIFIER : bitstring.
const PIDINIT : bitstring.
const a1label : bitstring.
const m2label : bitstring.
const m3label : bitstring.
fun kdf_k0(bitstring, bitstring) : key.
fun kdf_auth(key, bitstring, G, G) : key.
fun kdf_sess(key, G, G, G) : key.

fun senc(bitstring, key) : bitstring.
reduc forall m : bitstring, k : key; sdec(senc(m, k), k) = m.
fun venc(bitstring, key) : bitstring.
reduc forall v : bitstring, s : key; vdec(venc(v, s), s) = v.

fun dhexp(G, exponent) : G.
fun gen() : G.
equation forall x : exponent, y : exponent;
    dhexp(dhexp(gen(), x), y) = dhexp(dhexp(gen(), y), x).

fun gb(G) : bitstring [data].
fun keyToBit(key) : bitstring [data].

free SeedD : bitstring [private].
free s     : key      [private].
free PID   : bitstring.
free T1    : bitstring.      (* timestamp, models freshness anchor *)

free testKauth : bitstring [private].
free testKsess : bitstring [private].

query attacker(testKauth).
query attacker(testKsess).
query attacker(SeedD).

event deviceAccepts(G, G).
event serverFinished(G, G).
event serverAccepts(G, G).
event deviceFinishes(G, G).

query ga : G, gbv : G;
    inj-event(deviceAccepts(ga, gbv)) ==> inj-event(serverFinished(ga, gbv)).
query ga : G, gbv : G;
    inj-event(serverAccepts(ga, gbv)) ==> inj-event(deviceFinishes(ga, gbv)).

(* ---- device ---- *)
let deviceProc(K0 : key) =
    let Vi = hash((VERIFIER, SeedD)) in
    new x : exponent;
    let aG = dhexp(gen(), x) in
    (* M1: A1 binds aG (which doubles as the device nonce) *)
    let A1 = hash((a1label, PID, T1, gb(aG), Vi)) in
    out(c, (PID, T1, gb(aG), A1));

    (* receive M2 = bG, MAC2 *)
    in(c, (gbmsg : bitstring, mac2 : bitstring));
    let gb(bG) = gbmsg in
    let Kauth = kdf_auth(K0, Vi, aG, bG) in
    let (=hash((keyToBit(Kauth), gb(aG), gb(bG), m2label))) = mac2 in
    event deviceAccepts(aG, bG);

    (* M3: device confirmation *)
    event deviceFinishes(aG, bG);
    out(c, hash((keyToBit(Kauth), gb(bG), gb(aG), m3label)));

    (* session key from Z = abG *)
    let Z = dhexp(bG, x) in
    let Ksess = kdf_sess(Kauth, Z, aG, bG) in
    out(c, senc(testKsess, Ksess)).

(* ---- server ---- *)
let serverProc(K0 : key, storedVerifier : bitstring) =
    in(c, (=PID, =T1, gamsg : bitstring, A1 : bitstring));
    let gb(aG) = gamsg in
    let Vi = vdec(storedVerifier, s) in
    let (=hash((a1label, PID, T1, gb(aG), Vi))) = A1 in

    new y : exponent;
    let bG = dhexp(gen(), y) in
    let Kauth = kdf_auth(K0, Vi, aG, bG) in
    event serverFinished(aG, bG);
    (* M2 *)
    out(c, (gb(bG), hash((keyToBit(Kauth), gb(aG), gb(bG), m2label))));

    (* receive M3 *)
    in(c, mac3 : bitstring);
    let (=hash((keyToBit(Kauth), gb(bG), gb(aG), m3label))) = mac3 in
    event serverAccepts(aG, bG);

    let Z = dhexp(aG, y) in
    let Ksess = kdf_sess(Kauth, Z, aG, bG) in
    out(c, senc(testKauth, Kauth)).

process
    let Vi0 = hash((VERIFIER, SeedD)) in
    (* PID0 is derived from Vi0, NOT the same as the rotating wire
       identifier PID used in M1/A1. This matches the current design:
       K0 is bound to PID0 = XOF("PID_INIT" || Vi), which both parties
       can re-derive from Vi alone, so K0 stays fixed even though PID
       (the on-the-wire pseudonym) rotates every session. *)
    let PID0 = hash((PIDINIT, Vi0)) in
    let K0 = kdf_k0(Vi0, PID0) in
    let storedVerifier = venc(Vi0, s) in
    ( (!deviceProc(K0)) | (!serverProc(K0, storedVerifier)) )
